# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Opcional: ID de un servidor para registrar los comandos solo ahí durante
# desarrollo (los cambios se ven al instante, en vez de esperar hasta 1h).
DISCORD_GUILD_ID=

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/l2-raidboss-bot

# General
TIMEZONE=America/Bogota
# Opcional: cada cuánto se revisan las ventanas activas para alertar.
# Por defecto cada 15 min; para probar rápido usá '*/1 * * * *' (cada 1 min).
ALERT_CHECK_CRON=
